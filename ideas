def _wrap_deg(a):  # -> [-180,180)
    return (a + 180.0) % 360.0 - 180.0

def _circ_mean_deg(deg_list):
    s = sum(math.sin(math.radians(d)) for d in deg_list)
    c = sum(math.cos(math.radians(d)) for d in deg_list)
    return (math.degrees(math.atan2(s, c)) + 360.0) % 360.0

class AimStability:
    """
    Smooths wind; requires small errors for a dwell time; enforces a hard timeout.
    """
    def __init__(self,
                 window_sec=3.0,
                 sample_hz=10.0,
                 pitch_band_deg=1.0,   # how close pitch must be
                 yaw_band_deg=2.0,     # how close yaw must be
                 dwell_time=1.0,       # how long errors must stay small
                 deadband_cmd_pwm=4,   # ignore tiny PWM changes
                 max_wait=6.0):
        self.N = max(3, int(window_sec * sample_hz))
        self.ws = deque(maxlen=self.N)  # wind speeds
        self.wd = deque(maxlen=self.N)  # wind dirs (deg)
        self.pitch_band = pitch_band_deg
        self.yaw_band = yaw_band_deg
        self.dwell = dwell_time
        self.deadband_pwm = deadband_cmd_pwm
        self.max_wait = max_wait

        self._stable_since = None
        self._start = None
        self._last_yaw_pwm = None
        self._last_elev_pwm = None

    def start(self):
        self.ws.clear(); self.wd.clear()
        self._stable_since = None
        self._start = time.time()
        self._last_yaw_pwm = None
        self._last_elev_pwm = None

    def update_wind(self, speed_ms, dir_deg):
        # basic sanity; you can add spike rejection if needed
        if 0 <= speed_ms < 100:
            self.ws.append(float(speed_ms))
            self.wd.append(float(dir_deg) % 360.0)

    def robust_wind(self, cur_spd, cur_dir):
        if self.ws and self.wd:
            spd_med = stats.median(self.ws)
            dir_mean = _circ_mean_deg(list(self.wd))
            return spd_med, dir_mean
        return cur_spd, cur_dir  # fallback

    def gated(self, pitch_err_deg, yaw_err_deg):
        ok = (abs(pitch_err_deg) <= self.pitch_band) and (abs(yaw_err_deg) <= self.yaw_band)
        now = time.time()
        if ok:
            if self._stable_since is None:
                self._stable_since = now
            return (now - self._stable_since) >= self.dwell
        else:
            self._stable_since = None
            return False

    def timed_out(self):
        return (time.time() - self._start) >= self.max_wait

    def filter_pwm(self, yaw_pwm, elev_pwm):
        # Don't resend if change is tiny (reduces micro-chatter)
        send_yaw = True
        send_elev = True

        if self._last_yaw_pwm is not None and abs(yaw_pwm - self._last_yaw_pwm) < self.deadband_pwm:
            send_yaw = False
            yaw_pwm = self._last_yaw_pwm
        if self._last_elev_pwm is not None and abs(elev_pwm - self._last_elev_pwm) < self.deadband_pwm:
            send_elev = False
            elev_pwm = self._last_elev_pwm

        if send_yaw: self._last_yaw_pwm = yaw_pwm
        if send_elev: self._last_elev_pwm = elev_pwm
        return send_yaw, send_elev, yaw_pwm, elev_pwm

